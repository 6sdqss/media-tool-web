# Caddyfile — gộp frontend (reflex run, port 3000 nội bộ) + backend API
# (port 8000 nội bộ) ra 1 cổng duy nhất (Render forward traffic vào $PORT).
:{$PORT}

handle /_event/* {
    reverse_proxy 127.0.0.1:8000
}
handle /ping {
    reverse_proxy 127.0.0.1:8000
}
handle {
    reverse_proxy 127.0.0.1:3000
}
